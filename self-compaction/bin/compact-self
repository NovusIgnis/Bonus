#!/usr/bin/env bash
# compact-self: lets a Claude Code session running in tmux compact its own conversation when it decides to.
# A session cannot run /compact itself, so this script waits in the background until the session's turn ends
# (status "idle"), types "/compact <instructions>" into its tmux pane, waits for the compaction to finish and then
# sends one message so the session continues on its own.
#
# Usage:
#   compact-self usage [session]                          context size of the last reply (tokens) and the optional limit
#   compact-self now [session] "instructions" ["next"]    schedule: /compact after the turn ends, then the message "next"
# Without a session name: the tmux session of the calling pane (TMUX_PANE).
# Optional limit per session: a number of tokens in ~/.config/compact-self/limit/<session>.
#
# Relies on files Claude Code writes that we observed but that are not documented (Claude Code 2.1, November 2026):
#   <config>/sessions/<pid>.json with pid, sessionId, cwd, status (busy/idle/waiting) and tmux (session:window.pane);
#   <config>/projects/<cwd with non-alphanumerics replaced by "-">/<sessionId>.jsonl with "compact_boundary" entries.
# Written by Claude (Anthropic) for Fundacja Novus Ignis. Apache-2.0.
set -uo pipefail
CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/compact-self.log"; mkdir -p "$(dirname "$LOG")"
cmd="${1:-}"; shift || true
current() { tmux display-message -p -t "${TMUX_PANE:-}" '#S' 2>/dev/null; }

info() { # info <tmux session> <status|transcript>
  python3 -I - "$CFG" "$1" "$2" <<'PY'
import glob, json, os, sys
cfg, name, field = sys.argv[1:4]
for p in sorted(glob.glob(os.path.join(cfg, 'sessions', '*.json')), key=os.path.getmtime, reverse=True):
    try:
        d = json.load(open(p))
        if str(d.get('tmux', '')).split(':')[0] != name:
            continue
        os.kill(int(d['pid']), 0)
    except Exception:
        continue
    if field == 'status':
        print(d.get('status', ''))
    else:
        cwd = d.get('cwd') or ''
        print(os.path.join(cfg, 'projects', ''.join(c if c.isalnum() else '-' for c in cwd), d['sessionId'] + '.jsonl'))
    break
PY
}

boundary_after() { # boundary_after <transcript> <UTC start>: prints "yes" if a compaction boundary appeared after start
  python3 -I - "$1" "$2" <<'PY'
import json, sys
try:
    f = open(sys.argv[1], encoding='utf-8', errors='replace')
except OSError:
    sys.exit()
for line in f:
    if '"compact_boundary"' not in line:
        continue
    try:
        d = json.loads(line)
    except ValueError:
        continue
    if d.get('subtype') == 'compact_boundary' and str(d.get('timestamp', ''))[:19] >= sys.argv[2]:
        print('yes'); break
PY
}

case "$cmd" in
  usage)
    n="${1:-$(current)}"; t=$(info "$n" transcript)
    [ -n "$t" ] && [ -f "$t" ] || { echo "$n: no running Claude Code session found in this tmux session"; exit 2; }
    python3 -I - "$t" "$n" <<'PY'
import json, os, sys
path, name = sys.argv[1:3]
last = None
with open(path, encoding='utf-8', errors='replace') as f:
    for line in f:
        if '"compact_boundary"' in line:
            last = None; continue
        if '"usage"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        u = (d.get('message') or {}).get('usage')
        if d.get('type') == 'assistant' and u:
            last = u
if not last:
    sys.exit(f'{name}: no reply since the last compaction yet')
t = sum(int(last.get(k) or 0) for k in ('input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens'))
try:
    limit = int(open(os.path.expanduser(f'~/.config/compact-self/limit/{name}')).read().strip())
except (OSError, ValueError):
    limit = None
print(f'{name}: context about {t:,} tokens' + (f', limit {limit:,} ({100*t//limit}%)' if limit else ''))
PY
    ;;
  now)
    n="${1:-}"; ins="${2:-}"; next="${3:-}"
    # without a session name the first argument is the instructions and the second is "next"
    if [ -n "$n" ] && ! tmux has-session -t "=$n" 2>/dev/null; then next="$ins"; ins="$n"; n=""; fi
    n="${n:-$(current)}"
    tmux has-session -t "=$n" 2>/dev/null || { echo "no tmux session \"$n\""; exit 2; }
    ins=$(printf '%s' "$ins" | tr '\n\r\t' '   '); next=$(printf '%s' "$next" | tr '\n\r\t' '   ')
    setsid bash -c '
      n="$1"; ins="$2"; next="$3"; LOG="$4"; SELF="$5"; T="=$n:"
      log() { echo "$(date "+%F %T") $n: $*" >> "$LOG"; }
      log "waiting for the turn to end"
      sleep 5
      for i in $(seq 1 360); do [ "$(bash "$SELF" _status "$n")" = idle ] && break; sleep 5; done
      sleep 3
      if [ "$(bash "$SELF" _status "$n")" != idle ]; then log "not idle for 30 minutes, not compacting"; exit 1; fi
      start=$(date -u +%Y-%m-%dT%H:%M:%S)
      # type in chunks of 100 characters: a long string typed at once was taken as a paste and /compact did not run
      type_() { local s="$1" i; for ((i=0; i<${#s}; i+=100)); do tmux send-keys -t "$T" -l "${s:i:100}" || return 1; sleep 0.3; done; }
      type_ "/compact $ins" && sleep 1 && tmux send-keys -t "$T" Enter || { log "ERROR: tmux did not accept the keys"; exit 1; }
      log "typed /compact (${#ins} characters of instructions), waiting for the compaction"
      tr_=$(bash "$SELF" _transcript "$n")
      for i in $(seq 1 180); do [ "$(bash "$SELF" _boundary "$tr_" "$start")" = yes ] && break; sleep 5; done
      if [ "$(bash "$SELF" _boundary "$tr_" "$start")" != yes ]; then log "ERROR: no new compaction boundary after 15 minutes"; exit 1; fi
      sleep 5
      for i in $(seq 1 60); do [ "$(bash "$SELF" _status "$n")" = idle ] && break; sleep 5; done
      msg="[compaction script, not the user] Requested compaction finished at $(date +%H:%M). ${next:-Continue with the next step named in the compaction instructions.}"
      type_ "$msg" && sleep 1 && tmux send-keys -t "$T" Enter && log "compaction done, continuation message sent" || log "ERROR: could not send the continuation message"
    ' _ "$n" "$ins" "$next" "$LOG" "$0" </dev/null >/dev/null 2>&1 &
    echo "$n: compaction scheduled for the end of the turn, then a continuation message (log: $LOG)"
    ;;
  _status) info "${1:-}" status ;;
  _transcript) info "${1:-}" transcript ;;
  _boundary) boundary_after "${1:-}" "${2:-}" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
