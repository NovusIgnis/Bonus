#!/usr/bin/env bash
# Move a Claude Code session running in tmux to another account (another CLAUDE_CONFIG_DIR) and resume the same
# conversation there. Waits until the session is idle (up to 30 minutes), so no work is cut off.
# Usage: move-session <tmux-session> <config-dir> [extra claude flags...]
# Needs: both config folders share the conversation records (e.g. symlink <config-dir>/projects and sessions to one
# place), otherwise --resume does not find the conversation on the other account.
# Written by Claude (Anthropic) for Fundacja Novus Ignis. Apache-2.0.
set -uo pipefail
name="${1:-}"; cfg="${2:-}"; shift 2 2>/dev/null || true
[ -n "$name" ] && [ -d "$cfg" ] || { sed -n '2,6p' "$0"; exit 2; }
info() {  # prints "status sessionId cwd" of the live session whose tmux target starts with <name>:
  python3 -I - "$name" "$cfg" <<'PY'
import glob, json, os, sys
name, cfg = sys.argv[1], sys.argv[2]
dirs = {os.path.expanduser("~/.claude"), cfg, os.environ.get("CLAUDE_CONFIG_DIR") or ""}
for d in filter(None, dirs):
    for p in glob.glob(os.path.join(d, "sessions", "*.json")):
        try:
            s = json.load(open(p))
            if str(s.get("tmux", "")).split(":")[0] == name:
                os.kill(int(s["pid"]), 0)
                print(s.get("status", ""), s.get("sessionId", ""), s.get("cwd", ""))
                raise SystemExit
        except (OSError, ValueError, KeyError):
            pass
PY
}
for _ in $(seq 1 180); do read -r st id cwd <<<"$(info)"; [ "${st:-}" = idle ] && break; sleep 10; done
[ "${st:-}" = idle ] && [ -n "${id:-}" ] || { echo "$name: not idle for 30 minutes (or not found), nothing changed"; exit 1; }
tmux kill-session -t "=$name"; sleep 2
tmux new-session -d -s "$name" -c "${cwd:-$HOME}" "CLAUDE_CONFIG_DIR=$(printf %q "$cfg") claude --resume $id $*"
sleep 5
tmux has-session -t "=$name" 2>/dev/null && echo "$name: resumed $id with CLAUDE_CONFIG_DIR=$cfg" || { echo "$name: failed to start"; exit 1; }
